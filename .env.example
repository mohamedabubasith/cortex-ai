# ==============================================
# 🔐 Security (REQUIRED)
# ==============================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_this_to_a_secure_random_string

# ==============================================
# 🤖 AI / LLM (REQUIRED)
# ==============================================
OPENAI_API_KEY=sk-your-openai-key-here

# ==============================================
# 🗄️ Database (Defaults work with Docker)
# ==============================================
# These defaults match docker-compose.prod.yml
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=cognee_db

# ==============================================
# 🌐 Deployment (REQUIRED for Production)
# ==============================================
# Set this to your server's public IP or Domain
# Example: http://123.45.67.89:8000 or https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================
# ⚙️ Advanced Configuration (Optional)
# ==============================================
# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Email Settings (Optional)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# =============================================================================
# Cortex / Basivo — root .env (backend loads this path; see backend/main.py)
# Copy to .env and set values. Never commit .env.
# =============================================================================
#
# Docker / Coolify: backend Dockerfile runs `alembic upgrade head` before uvicorn,
# so schema upgrades apply on each deploy — you do not need a separate migration step
# unless you override the container command.
#
# First superuser: set ADMIN_EMAIL + ADMIN_PASSWORD below. On startup, if no
# superuser exists yet, one is created (see app/core/startup.py + main.py lifespan).
# You can also run: cd backend && uv run python -m app.core.startup
#
# Reset Postgres (DESTRUCTIVE): stop stack, remove the postgres volume (Coolify:
# delete/rename the volume or database service), redeploy so migrations + admin seed run again.
# Or: docker compose down -v  (removes volumes named in compose) then up.
# =============================================================================

# --- Security (required in production) ---
SECRET_KEY=replace_with_python_secrets_token_hex_32
ADMIN_SECRET_KEY=replace_with_a_second_secret_for_admin_api_headers

# --- Default admin (created only when no superuser exists) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
DEFAULT_ADMIN_NAME=System Administrator

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
API_V1_STR=/api/v1
PROJECT_NAME=Basivo
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (use DATABASE_URL in Docker, or DB_* for local) ---
# DATABASE_URL=postgresql+asyncpg://admin:changeme@db:5432/chat_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USERNAME=admin
DB_PASSWORD=changeme

VECTOR_DB_PROVIDER=pgvector
# VECTOR_DB_URL=postgresql+asyncpg://admin:changeme@localhost:5432/chat_db

# --- Knowledge base / RAG (required for KB ingest) ---
UNSTRUCTURED_API_URL=http://127.0.0.1:8000
UNSTRUCTURED_GENERAL_PATH=general/v0/general
# UNSTRUCTURED_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=paraphrase-multilingual:latest
OLLAMA_PREFER_API_EMBED=true
OLLAMA_EMBED_TRUNCATE=true

# Include :6333 for native Qdrant, or :80 / :443 if behind a reverse proxy.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=cortex_kb
# QDRANT_API_KEY=

RAG_EMBEDDING_BATCH_SIZE=64
RAG_QDRANT_WRITE_BATCH_SIZE=128
KB_EMBEDDING_MAX_INPUT_TOKENS=512
KB_CHUNK_CHARS_PER_TOKEN=4.0
KB_MIN_CHUNK_CHARS=256

# --- Legacy embedding fields (non-KB code paths) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=paraphrase-multilingual:latest

# --- Email / auth ---
AUTH_PROVIDER=local
EMAIL_PROVIDER=console
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=

# --- Frontend build (docker / local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

LOG_LEVEL=INFO
TOKENIZERS_PARALLELISM=true

# --- Optional: knowledge graph ---
ENABLE_GRAPH=false
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

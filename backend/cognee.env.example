# Database Configuration (Postgres)
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognee_db
DB_USER=postgres
DB_PASSWORD=postgres

# Vector Database Configuration (PGVector)
# Note: Ensure the 'vector' extension is enabled in your Postgres database
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognee_db

# LLM Configuration
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o
LLM_ENDPOINT=https://api.openai.com/v1 # Optional

# ─────────────────────────────────────────────────────────────────
# Basivo / Cortex AI — Backend Environment Variables
# Copy this file to the repository root `.env` and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
PROJECT_NAME=Basivo
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:3000

# ── Database (TimescaleDB / PostgreSQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USERNAME=admin
DB_PASSWORD=changeme

# Or supply a full URL directly (takes precedence over DB_* vars above)
# DATABASE_URL=postgresql+asyncpg://admin:changeme@localhost:5432/chat_db

# ── Security ─────────────────────────────────────────────────────
# IMPORTANT: generate a strong random key for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Secret required to call admin-only endpoints (e.g. /api/v1/admin/*)
ADMIN_SECRET_KEY=replace_me_with_another_secret

# ── Default Admin User ───────────────────────────────────────────
# Created automatically on first startup if no superuser exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
DEFAULT_ADMIN_NAME=System Administrator

# ── Authentication Provider ──────────────────────────────────────
# Options: "local" (username/password) | "keycloak" (SSO)
AUTH_PROVIDER=local

# Google OAuth2 (optional — only needed if enabling Google sign-in)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Email ────────────────────────────────────────────────────────
# Options: "smtp" | "console" (prints to stdout) | "none" (disabled)
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=your_smtp_password
# EMAILS_FROM_EMAIL=no-reply@example.com
# EMAILS_FROM_NAME=Basivo

RESET_PASSWORD_TOKEN_EXPIRE_MINUTES=15

# ── Embeddings (legacy app-wide fields; KB uses Ollama via settings below) ──
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=paraphrase-multilingual:latest

# ── Knowledge base (Haystack + Unstructured + Ollama + Qdrant) ───────────────
UNSTRUCTURED_API_URL=http://127.0.0.1:8000
UNSTRUCTURED_GENERAL_PATH=general/v0/general
# UNSTRUCTURED_API_KEY=   # optional; required by some Unstructured SaaS / secured instances
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=paraphrase-multilingual:latest
# Use POST /api/embed (recommended). Set false only if your reverse proxy exposes /api/embeddings but not /api/embed.
# OLLAMA_PREFER_API_EMBED=true
# OLLAMA_EMBED_TRUNCATE=true
QDRANT_URL=http://127.0.0.1:6333
# If Qdrant sits behind HTTP on port 80 (reverse proxy), use e.g. http://qdrant.example:80
# QDRANT_URL=http://your-qdrant-host:80
# Must match the collection name in Qdrant (e.g. Rag for your hosted instance).
# Haystack can only use a collection it created, or an empty one — not a legacy Qdrant collection.
QDRANT_COLLECTION=Rag
# Required when Qdrant enforces API keys / Bearer auth.
# QDRANT_API_KEY=

# Ingest throughput (optional): larger batches = fewer Ollama HTTP round-trips per document.
# RAG_EMBEDDING_BATCH_SIZE=64
# RAG_QDRANT_WRITE_BATCH_SIZE=128
# Chunk size cap (chars) ≈ KB_EMBEDDING_MAX_INPUT_TOKENS × KB_CHUNK_CHARS_PER_TOKEN.
# Set KB_EMBEDDING_MAX_INPUT_TOKENS to your model's token context (``ollama show <model>`` → e.g. bert.context_length=512).
# KB_EMBEDDING_MAX_INPUT_TOKENS=512
# KB_CHUNK_CHARS_PER_TOKEN=4.0
# KB_MIN_CHUNK_CHARS=256

# ── Vector Store (application DB / legacy) ─────────────────────────────────
VECTOR_DB_PROVIDER=pgvector

# pgvector connection URL (optional — falls back to DATABASE_URL / DB_* if not set)
# VECTOR_DB_URL=postgresql+asyncpg://admin:changeme@localhost:5432/chat_db

# ── Knowledge Graph (optional) ───────────────────────────────────
# Enables Neo4j-backed knowledge graph features. Disabled by default.
ENABLE_GRAPH=false
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ── Logging ──────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Tokenizers ───────────────────────────────────────────────────
TOKENIZERS_PARALLELISM=true
